// The stand-in for tools/gen_build_info.py's VERSIONINFO when it has not run (no Python on the build
// machine): the generated Platform/BuildInfo.rc2 comes first on App.rc's include path (Engine.App.props).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "Game"
            VALUE "ProductVersion", "0.0.0"
            VALUE "FileVersion", "0.0.0"
            VALUE "FileDescription", "Game"
            VALUE "Comments", "build identity unknown (tools/gen_build_info.py did not run)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
